# Template for `.env.development`, used by `docker-compose.yml` (the
# `frontend` service's `env_file`). Copy this to `.env.development` and
# adjust if needed; `.env.development` itself is git-ignored.
#
# Unprefixed (no NEXT_PUBLIC_) because this is only read server-side today —
# there is no client-side fetch code yet (see business-management-infra
# CLAUDE.md §3/§6). If a client component ever needs the API base URL
# directly, add a separate NEXT_PUBLIC_ var rather than prefixing this one.
#
# Inside docker-compose, "backend" is the backend container's service name
# on the shared zhamo-network — not localhost, and not the 3001 host port
# mapping (that mapping is only for reaching the API from the host/browser).
BACKEND_API_BASE_URL=http://backend:3000/api/v1

# Phase 4: avatars load directly from the backend, browser-side (D2) — this
# has to be the host-mapped port the browser can actually reach, not the
# "backend" service name above (that only resolves inside zhamo-network).
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:3001
